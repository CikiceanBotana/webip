{
  "name": "webip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Two-lane web inspection tool: fast browser-free HTTP lane + slow Chromium layout lane.",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "scan": "tsx src/cli.ts",
    "analyze": "tsx scripts/analyze.ts",
    "examples": "tsx scripts/examples.ts",
    "smoke": "tsx scripts/smoke.ts",
    "versions": "tsx scripts/versions.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "install:lychee": "./scripts/install-lychee.sh"
  },
  "dependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "accessibility-checker": "4.0.29",
    "axe-core": "4.12.1",
    "cheerio": "1.2.0",
    "crawlee": "3.17.0",
    "html-validate": "11.6.2",
    "lighthouse": "13.4.1",
    "playwright": "1.62.1",
    "vnu-jar": "26.7.31"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.5",
    "typescript": "7.0.2"
  }
}
